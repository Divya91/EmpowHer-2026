# Copy to .env and fill in your Supabase credentials
# Get these from: Supabase Dashboard → Project Settings → Database

SUPABASE_JDBC_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password_here

# Optional: JWT override
JWT_SECRET=SkySafarSuperSecretKeyForFlightBookingApplication2026SecretKey
